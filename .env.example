# PostgreSQL
POSTGRES_DB=examflow
POSTGRES_USER=examflow
POSTGRES_PASSWORD=examflow_password
DATABASE_URL=postgresql://examflow:examflow_password@localhost:5432/examflow

# Core API
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=8h
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SEED_DATABASE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TRUST_PROXY=false

# Optional microservices for non-Docker development
AI_SERVICE_URL=http://localhost:4101
REPORT_SERVICE_URL=http://localhost:4102

# AI mode: local requires no key; external uses an OpenAI-compatible chat-completions endpoint.
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
